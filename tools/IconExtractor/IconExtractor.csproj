<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202611" />
    <PackageReference Include="CUE4Parse-Conversion" Version="1.2.2.202611" />
    <!-- Transitive (via IndexRange); 9.0.0 has a DoS advisory, GHSA-73j8-2gch-69rq. -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="9.0.14" />
    <!-- SixLabors.ImageSharp is NOT shipped. CUE4Parse-Conversion depends on it
         (3.1.12, affected by CVE-2026-106118 / GHSA-v76p-62qx-wwq2 and other TIFF/ICC
         advisories; fixed versions need a paid license key to build), but the only
         ImageSharp members it references are encoders and LoadPixelData, and the
         code paths this tool uses never touch them: built without ImageSharp, an
         extraction gives the same 765 files byte for byte. ExcludeAssets keeps the
         assembly out of the published exe. NuGet's audit still lists the package
         because it stays in the dependency graph. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" ExcludeAssets="all" />
  </ItemGroup>

  <!-- NuGet's audit checks the whole dependency graph, so it keeps flagging the
       ImageSharp that CUE4Parse-Conversion declares even though it isn't shipped
       (see above). These are exactly its advisories (CVE-2026-106118 is
       GHSA-v76p-62qx-wwq2). build.ps1 fails the build if ImageSharp ever appears in
       the helper's output, so this can't hide a shipped copy. Any new advisory, for
       any package, still warns. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
  </ItemGroup>

</Project>
